   "source": [
    "import pandas as pd\n",
    "import json\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# --- Android devices (schema com models[]) ---\n",
    "android_runs = {\n",
    "    \"reference mobile device\": [\n",
    "        ROOT / \"results/s24p_metrics_cifar10_cpu_400imgs_1775267671116.json\",\n",
    "        ROOT / \"results/s24p_metrics_cifar100_cpu_400imgs_1775267691899.json\",\n",
    "        ROOT / \"results/s24p_metrics_wakevision_cpu_400imgs_1775267738764.json\",\n",
    "    ],\n",
    "    \"Samsung Galaxy A14\": [\n",
    "        ROOT / \"results/a14_metrics_cifar10_cpu_400imgs_1775245845979.json\",\n",
    "        ROOT / \"results/a14_metrics_cifar100_cpu_400imgs_1775245894612.json\",\n",
    "        ROOT / \"results/a14_metrics_wakevision_cpu_400imgs_1775245982177.json\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "DATASET_DISPLAY_PI = {\n",
    "    \"cifar10\": \"CIFAR-10\",\n",
    "    \"cifar100\": \"CIFAR-100\",\n",
    "    \"wakevision\": \"Wake Vision\",\n",
    "}\n",
    "\n",
    "DATASET_DISPLAY_ANDROID = {\n",
    "    \"cifar10\": \"CIFAR-10\",\n",
    "    \"cifar100\": \"CIFAR-100\",\n",
    "    \"wakevision\": \"Wake Vision\",\n",
    "    \"CIFAR-10\": \"CIFAR-10\",\n",
    "    \"CIFAR-100\": \"CIFAR-100\",\n",
    "    \"Wake Vision\": \"Wake Vision\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_dataset_name(name: str) -> str:\n",
    "    key = str(name).strip()\n",
    "    return DATASET_DISPLAY_ANDROID.get(key, DATASET_DISPLAY_ANDROID.get(key.lower(), key))\n",
    "\n",
    "\n",
    "def base_model_from_android(name: str) -> str:\n",
    "    if \"EfficientNet\" in name:\n",
    "        return \"EfficientNetB0\"\n",
    "    if \"MCUNet\" in name:\n",
    "        return \"MCUNet\"\n",
    "    if \"MobileNet\" in name:\n",
    "        return \"MobileNetV3-Small\"\n",
    "    return name\n",
    "\n",
    "\n",
    "def base_model_from_pi(name: str) -> str:\n",
    "    n = name.lower()\n",
    "    if \"efficientnet\" in n:\n",
    "        return \"EfficientNetB0\"\n",
    "    if \"lcnn\" in n or \"mcunet\" in n:\n",
    "        return \"MCUNet\"\n",
    "    if \"mobilenet\" in n:\n",
    "        return \"MobileNetV3-Small\"\n",
    "    return name\n",
    "\n",
    "\n",
    "def load_pi_report(path):\n",
    "    rows = []\n",
    "    with open(path, \"r\", encoding=\"utf-8\") as f:\n",
    "        report = json.load(f)\n",
    "    for block in report.get(\"results\", []):\n",
    "        ds_key = block[\"dataset\"]\n",
    "        ds_name = DATASET_DISPLAY_PI.get(ds_key, ds_key)\n",
    "        for m in block.get(\"models\", []):\n",
    "            if m.get(\"error\"):\n",
    "                continue\n",
    "            lat = m[\"latency_ms\"]\n",
    "            rows.append(\n",
    "                {\n",
    "                    \"Dataset\": ds_name,\n",
    "                    \"Model\": base_model_from_pi(m[\"model\"]),\n",
    "                    \"Accuracy (%)\": float(m[\"accuracy\"]) * 100,\n",
    "                    \"Average Latency (ms)\": float(lat[\"avg\"]),\n",
    "                    \"P90 Latency (ms)\": float(lat[\"p90\"]),\n",
    "                    \"Throughput (FPS)\": float(m[\"throughput_img_s\"]),\n",
    "                    \"Platform\": \"Raspberry Pi\",\n",
    "                }\n",
    "            )\n",
    "    return rows\n",
    "\n",
    "\n",
    "data = []\n",
    "\n",
    "# Load Android runs (S24+ e A14)\n",
    "for platform_name, files in android_runs.items():\n",
    "    for file in files:\n",
    "        if not file.exists():\n",
    "            print(f\"Note: Android file not found (skipped): {file}\")\n",
    "            continue\n",
    "        with open(file, \"r\", encoding=\"utf-8\") as f:\n",
    "            content = json.load(f)\n",
    "        for model in content.get(\"models\", []):\n",
    "            data.append(\n",
    "                {\n",
    "                    \"Dataset\": normalize_dataset_name(model[\"datasetName\"]),\n",
    "                    \"Model\": base_model_from_android(model[\"modelName\"]),\n",
    "                    \"Accuracy (%)\": float(model[\"accuracy\"]) * 100,\n",
    "                    \"Average Latency (ms)\": float(model[\"avgLatencyMs\"]),\n",
    "                    \"P90 Latency (ms)\": float(model[\"p90LatencyMs\"]),\n",
    "                    \"Throughput (FPS)\": float(model[\"throughputImagesPerSecond\"]),\n",
    "                    \"Platform\": platform_name,\n",
    "                }\n",
    "            )\n",
    "\n",
    "# Load Raspberry Pi runs\n",
    "for pi_path in (\n",
    "    ROOT / \"results/results_cifar_pi.json\",\n",
    "    ROOT / \"results/results_final_wakevision_pi.json\",\n",
    "):\n",
    "    if pi_path.exists():\n",
    "        data.extend(load_pi_report(pi_path))\n",
    "    else:\n",
    "        print(f\"Note: Pi file not found (skipped): {pi_path}\")\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "_ds_order = [\"CIFAR-10\", \"CIFAR-100\", \"Wake Vision\"]\n",
    "df[\"Dataset\"] = pd.Categorical(df[\"Dataset\"], categories=_ds_order, ordered=True)\n",
    "_model_order = [\"MobileNetV3-Small\", \"EfficientNetB0\", \"MCUNet\"]\n",
    "df[\"Model\"] = pd.Categorical(df[\"Model\"], categories=_model_order, ordered=True)\n",
    "df = df.sort_values([\"Platform\", \"Dataset\", \"Model\"]).reset_index(drop=True)\n",
    "\n",
    "# Visual settings for the plots\n",
    "sns.set_theme(style=\"whitegrid\", context=\"talk\")\n",
    "_palette = \"viridis\"\n",
    "\n",
    "_metrics = [\n",
    "    (\"P90 Latency (ms)\", \"P90 latency (ms)\"),\n",
    "    (\"Throughput (FPS)\", \"Throughput (images/s)\"),\n",
    "    (\"Accuracy (%)\", \"Accuracy (%)\"),\n",
    "]\n",
    "\n",
    "_platform_order = [\"reference mobile device\", \"Samsung Galaxy A14\", \"Raspberry Pi\"]\n",
    "_platforms = [p for p in _platform_order if p in set(df[\"Platform\"])]\n",
    "\n",
    "# 1) Plots individuais por aparelho\n",
    "for platform in _platforms:\n",
    "    sub_df = df[df[\"Platform\"] == platform]\n",
    "    for col, ylabel in _metrics:\n",
    "        plt.figure(figsize=(8, 6))\n",
    "        ax = sns.barplot(data=sub_df, x=\"Dataset\", y=col, hue=\"Model\", palette=_palette)\n",
    "        ax.set_title(f\"{col} — {platform}\")\n",
    "        ax.set_xlabel(\"Dataset\")\n",
    "        ax.set_ylabel(ylabel)\n",
    "        for container in ax.containers:\n",
    "            ax.bar_label(container, fmt=\"%.1f\", padding=3, fontsize=9)\n",
    "        handles, labels = ax.get_legend_handles_labels()\n",
    "        if handles:\n",
    "            ax.legend(handles, labels, title=\"Architecture\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "\n",
    "# 2) Plots com todos os aparelhos juntos (subplots)\n",
    "for col, ylabel in _metrics:\n",
    "    n_p = max(1, len(_platforms))\n",
    "    fig_w = 7 * n_p\n",
    "    fig, axes = plt.subplots(1, n_p, figsize=(fig_w, 6), sharey=True)\n",
    "    if n_p == 1:\n",
    "        axes = [axes]\n",
    "    for ax, platform in zip(axes, _platforms):\n",
    "        sub = df[df[\"Platform\"] == platform]\n",
    "        sns.barplot(data=sub, x=\"Dataset\", y=col, hue=\"Model\", palette=_palette, ax=ax)\n",
    "        ax.set_title(platform)\n",
    "        ax.set_xlabel(\"Dataset\")\n",
    "        ax.set_ylabel(ylabel)\n",
    "        for container in ax.containers:\n",
    "            ax.bar_label(container, fmt=\"%.1f\", padding=3, fontsize=9)\n",
    "    handles, labels = axes[0].get_legend_handles_labels()\n",
    "    for ax in axes[1:]:\n",
    "        if ax.legend_:\n",
    "            ax.legend_.remove()\n",
    "    if handles:\n",
    "        axes[0].legend(handles, labels, title=\"Architecture\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
    "    fig.suptitle(f\"{col} — S24+ vs A14 vs Raspberry Pi\", y=1.02)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "# Tabela completa\n",
    "display(df)"
