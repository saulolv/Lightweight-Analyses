   "source": [
    "## CIFAR-100-C Corruption Error (CE)\n",
    "\n",
    "This notebook evaluates CIFAR-100 models on **CIFAR-100-C** (common corruptions in natural images) and reports **accuracy per severity (1-5)** and **Corruption Error (CE)**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "9354fefb",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "\n",
    "def project_root() -> Path:\n",
    "    \"\"\"Resolve repo root (repo root, notebooks/, or other subfolders).\"\"\"\n",
    "    cwd = Path.cwd().resolve()\n",
    "    for d in [cwd, *cwd.parents]:\n",
    "        km = d / \"keras_models\"\n",
    "        if km.is_dir() and any(km.glob(\"*.keras\")):\n",
    "            return d\n",
    "        if (d / \".git\").exists() and (d / \"results\").is_dir():\n",
    "            return d\n",
    "    if (cwd / \"datasets\").is_dir() or (cwd / \"results\").is_dir():\n",
    "        return cwd\n",
    "    if (cwd.parent / \"datasets\").is_dir() or (cwd.parent / \"results\").is_dir():\n",
    "        return cwd.parent\n",
    "    return cwd\n",
    "\n",
    "\n",
    "ROOT = project_root()\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7fcf2530",
   "metadata": {},
   "outputs": [],
   "source": [
    "from __future__ import annotations\n",
    "\n",
    "import os\n",
    "import tarfile\n",
    "import urllib.request\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import tensorflow as tf\n",
    "\n",
    "# If you get NameError due to out-of-order execution, run this cell first."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "613d75ed",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OK (already exists): C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\datasets\\cifar100c\\CIFAR-100-C.tar (2918.5 MB)\n",
      "OK (already extracted): C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\datasets\\cifar100c\\CIFAR-100-C\\labels.npy\n"
     ]
    }
   ],
   "source": [
    "# Directory where CIFAR-100-C is cached\n",
    "DATA_DIR = ROOT / \"datasets\"\n",
    "CIFAR100C_DIR = DATA_DIR / \"cifar100c\"\n",
    "CIFAR100C_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Official URL (Hendrycks & Dietterich) via Zenodo\n",
    "CIFAR100C_TAR_URL = \"https://zenodo.org/record/3555552/files/CIFAR-100-C.tar?download=1\"\n",
    "CIFAR100C_TAR_PATH = CIFAR100C_DIR / \"CIFAR-100-C.tar\"\n",
    "\n",
    "\n",
    "def download_file(url: str, out_path: Path, chunk_size: int = 1024 * 1024) -> None:\n",
    "    out_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "    if out_path.exists() and out_path.stat().st_size > 0:\n",
    "        print(f\"OK (already exists): {out_path} ({out_path.stat().st_size/1e6:.1f} MB)\")\n",
    "        return\n",
    "\n",
    "    print(\"Downloading (this may take a while; large file):\", url)\n",
    "    tmp_path = out_path.with_suffix(out_path.suffix + \".part\")\n",
    "    if tmp_path.exists():\n",
    "        tmp_path.unlink()\n",
    "\n",
    "    with urllib.request.urlopen(url) as r, open(tmp_path, \"wb\") as f:\n",
    "        total_hdr = r.headers.get(\"Content-Length\")\n",
    "        total = int(total_hdr) if total_hdr and total_hdr.isdigit() else None\n",
    "\n",
    "        downloaded = 0\n",
    "        next_report = 0\n",
    "        report_step = 50 * 1024 * 1024  # 50 MB\n",
    "\n",
    "        while True:\n",
    "            chunk = r.read(chunk_size)\n",
    "            if not chunk:\n",
    "                break\n",
    "            f.write(chunk)\n",
    "            downloaded += len(chunk)\n",
    "\n",
    "            if downloaded >= next_report:\n",
    "                next_report = downloaded + report_step\n",
    "                if total:\n",
    "                    pct = 100.0 * downloaded / total\n",
    "                    print(f\"  {pct:6.2f}% ({downloaded/1e6:.1f}/{total/1e6:.1f} MB)\")\n",
    "                else:\n",
    "                    print(f\"  {downloaded/1e6:.1f} MB\")\n",
    "\n",
    "    tmp_path.replace(out_path)\n",
    "    print(\"Download finished:\", out_path)\n",
    "\n",
    "\n",
    "def extract_tar(tar_path: Path, out_dir: Path) -> None:\n",
    "    # The tar contains a CIFAR-100-C/ directory with .npy files.\n",
    "    marker = out_dir / \"CIFAR-100-C\" / \"labels.npy\"\n",
    "    if marker.exists():\n",
    "        print(\"OK (already extracted):\", marker)\n",
    "        return\n",
    "\n",
    "    print(\"Extracting:\", tar_path)\n",
    "    with tarfile.open(tar_path, \"r\") as tar:\n",
    "        # Python 3.12+ recommends filter=\"data\" for safer extraction.\n",
    "        try:\n",
    "            tar.extractall(path=out_dir, filter=\"data\")\n",
    "        except TypeError:\n",
    "            # Compatibility with older Python versions.\n",
    "            tar.extractall(path=out_dir)\n",
    "\n",
    "    print(\"Extraction completed at:\", out_dir)\n",
    "\n",
    "\n",
    "download_file(CIFAR100C_TAR_URL, CIFAR100C_TAR_PATH)\n",
    "extract_tar(CIFAR100C_TAR_PATH, CIFAR100C_DIR)"
   ]
  },
