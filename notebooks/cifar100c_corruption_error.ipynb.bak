   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "OK: MobileNetV3Small <- C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\keras_models\\MobileNetV3Small_CIFAR100.keras\n",
      "OK: EfficientNetB0 <- C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\keras_models\\EfficientNetB0_CIFAR100.keras\n",
      "OK: MCUNet_Official <- C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\keras_models\\MCUNet_Official_CIFAR100.keras\n",
      "IMG_SIZE: 160\n",
      "NUM_CLASSES: 100\n"
     ]
    }
   ],
   "source": [
    "# Load one or more project Keras (.keras) models.\n",
    "\n",
    "# Register custom layer needed by MCUNet_Official .keras files.\n",
    "try:\n",
    "    from keras.saving import register_keras_serializable as _register\n",
    "except Exception:\n",
    "    from tensorflow.keras.utils import register_keras_serializable as _register\n",
    "\n",
    "\n",
    "@_register(package=\"MCUNet\")\n",
    "class ImageNetNormalization(tf.keras.layers.Layer):\n",
    "    def __init__(self, mean=(0.485, 0.456, 0.406), std=(0.229, 0.224, 0.225), **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self._mean = tuple(float(v) for v in mean)\n",
    "        self._std = tuple(float(v) for v in std)\n",
    "        self.mean = tf.constant(self._mean, dtype=tf.float32)\n",
    "        self.std = tf.constant(self._std, dtype=tf.float32)\n",
    "\n",
    "    def call(self, inputs):\n",
    "        x = tf.cast(inputs, tf.float32)\n",
    "        x = x / 255.0\n",
    "        return (x - self.mean) / self.std\n",
    "\n",
    "    def get_config(self):\n",
    "        cfg = super().get_config()\n",
    "        cfg.update({\"mean\": self._mean, \"std\": self._std})\n",
    "        return cfg\n",
    "\n",
    "\n",
    "MODELS = [\n",
    "    (\"MobileNetV3Small\", ROOT / \"keras_models\" / \"MobileNetV3Small_CIFAR100.keras\"),\n",
    "    (\"EfficientNetB0\", ROOT / \"keras_models\" / \"EfficientNetB0_CIFAR100.keras\"),\n",
    "    (\"MCUNet_Official\", ROOT / \"keras_models\" / \"MCUNet_Official_CIFAR100.keras\"),\n",
    "]\n",
    "\n",
    "\n",
    "def load_models(specs):\n",
    "    out = []\n",
    "    for name, path in specs:\n",
    "        if not path.exists():\n",
    "            print(f\"WARNING: {path} not found, skipping...\")\n",
    "            continue\n",
    "        m = tf.keras.models.load_model(path)\n",
    "        m.trainable = False\n",
    "        out.append((name, path, m))\n",
    "        print(\"OK:\", name, \"<-\", path)\n",
    "    return out\n",
    "\n",
    "\n",
    "models = load_models(MODELS)\n",
    "\n",
    "if not models:\n",
    "    print(\"ROOT:\", ROOT.resolve())\n",
    "    print(\"keras_models dir:\", ROOT / \"keras_models\", \"exists:\", (ROOT / \"keras_models\").is_dir())\n",
    "    for _n, _p in MODELS:\n",
    "        print(f\"  {_n}: {_p.resolve()} exists={_p.exists()}\")\n",
    "    raise RuntimeError(\"No models found. Check paths above or place .keras files under keras_models/. Run the ROOT cell first.\")\n",
    "\n",
    "# Infer IMG_SIZE from the first model (assuming all models use the same input size)\n",
    "IMG_SIZE = int(models[0][2].input_shape[1])\n",
    "BATCH_SIZE = 128\n",
    "NUM_CLASSES = 100\n",
    "\n",
    "print(\"IMG_SIZE:\", IMG_SIZE)\n",
    "print(\"NUM_CLASSES:\", NUM_CLASSES)\n",
    "\n",
    "# CIFAR-100 fine-label class names\n",
    "class_names = [\n",
    "    'apple', 'aquarium_fish', 'baby', 'bear', 'beaver', 'bed', 'bee', 'beetle',\n",
    "    'bicycle', 'bottle', 'bowl', 'boy', 'bridge', 'bus', 'butterfly', 'camel',\n",
    "    'can', 'castle', 'caterpillar', 'cattle', 'chair', 'chimpanzee', 'clock',\n",
    "    'cloud', 'cockroach', 'couch', 'crab', 'crocodile', 'cup', 'dinosaur',\n",
    "    'dolphin', 'elephant', 'flatfish', 'forest', 'fox', 'girl', 'hamster',\n",
    "    'house', 'kangaroo', 'keyboard', 'lamp', 'lawn_mower', 'leopard', 'lion',\n",
    "    'lizard', 'lobster', 'man', 'maple_tree', 'motorcycle', 'mountain', 'mouse',\n",
    "    'mushroom', 'oak_tree', 'orange', 'orchid', 'otter', 'palm_tree', 'pear',\n",
    "    'pickup_truck', 'pine_tree', 'plain', 'plate', 'poppy', 'porcupine',\n",
    "    'possum', 'rabbit', 'raccoon', 'ray', 'road', 'rocket', 'rose',\n",
    "    'sea', 'seal', 'shark', 'shrew', 'skunk', 'skyscraper', 'snail', 'snake',\n",
    "    'spider', 'squirrel', 'streetcar', 'sunflower', 'sweet_pepper', 'table',\n",
    "    'tank', 'telephone', 'television', 'tiger', 'tractor', 'train', 'trout',\n",
    "    'tulip', 'turtle', 'wardrobe', 'whale', 'willow_tree', 'wolf', 'woman', 'worm',\n",
    "]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "f688e989",
   "metadata": {},
   "outputs": [],
   "source": [
    "AUTOTUNE = tf.data.AUTOTUNE\n",
    "\n",
    "\n",
    "def preprocess_image_for_model(image, label):\n",
    "    # CIFAR-100-C data is uint8 in [0, 255].\n",
    "    image = tf.cast(image, tf.float32)\n",
    "    image = tf.image.resize(image, (IMG_SIZE, IMG_SIZE), method=\"bilinear\")\n",
    "    return image, label\n",
    "\n",
    "\n",
    "def make_ds(x: np.ndarray, y: np.ndarray, batch_size: int = BATCH_SIZE):\n",
    "    ds = tf.data.Dataset.from_tensor_slices((x, y))\n",
    "    ds = ds.map(preprocess_image_for_model, num_parallel_calls=AUTOTUNE)\n",
    "    ds = ds.batch(batch_size)\n",
    "    ds = ds.prefetch(AUTOTUNE)\n",
    "    return ds\n",
    "\n",
    "\n",
    "def accuracy_on_ds(model: tf.keras.Model, ds: tf.data.Dataset) -> float:\n",
    "    correct = 0\n",
    "    total = 0\n",
    "    for xb, yb in ds:\n",
    "        logits = model(xb, training=False)\n",
    "        pred = tf.argmax(logits, axis=-1, output_type=yb.dtype)\n",
    "        correct += int(tf.reduce_sum(tf.cast(pred == yb, tf.int32)).numpy())\n",
    "        total += int(yb.shape[0])\n",
    "    return correct / max(total, 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "157009a1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "MobileNetV3Small clean_acc=0.7301 clean_err=0.2699\n"
     ]
    }
   ],
   "source": [
    "def load_corruption(corruption: str) -> np.ndarray:\n",
    "    path = CIFAR100C_ROOT / f\"{corruption}.npy\"\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(f\"Could not find {path}\")\n",
    "    x = np.load(path)  # (50000, 32, 32, 3)\n",
    "    if x.ndim != 4 or x.shape[1:4] != (32, 32, 3):\n",
    "        raise ValueError(f\"Unexpected shape in {path.name}: {x.shape}\")\n",
    "    return x\n",
    "\n",
    "\n",
    "def eval_corruption_acc(model: tf.keras.Model, corruption: str, severities=None) -> dict:\n",
    "    \"\"\"Return per-severity accuracies and average over severities 1-5.\"\"\"\n",
    "    if severities is None:\n",
    "        severities = globals().get(\"SEVERITIES\", [1, 2, 3, 4, 5])\n",
    "    n_per = int(globals().get(\"N_PER_SEVERITY\", 10_000))\n",
    "\n",
    "    x = load_corruption(corruption)\n",
    "    out = {\"corruption\": corruption}\n",
    "\n",
    "    for s in severities:\n",
    "        start = (s - 1) * n_per\n",
    "        end = s * n_per\n",
    "        x_s = x[start:end]\n",
    "        y_s = y_c[start:end]\n",
    "\n",
    "        ds = make_ds(x_s, y_s)\n",
    "        out[f\"acc_s{s}\"] = accuracy_on_ds(model, ds)\n",
    "\n",
    "    out[\"acc_mean_1_5\"] = float(np.mean([out[f\"acc_s{s}\"] for s in severities]))\n",
    "    return out\n",
    "\n",
    "\n",
    "def err_from_acc(acc: float) -> float:\n",
    "    return 1.0 - float(acc)\n",
    "\n",
    "\n",
    "# Evaluate all models on clean CIFAR-100 and pick baseline = worst clean accuracy.\n",
    "(x_train, y_train), (x_test, y_test) = tf.keras.datasets.cifar100.load_data()\n",
    "\n",
    "y_test = y_test.squeeze().astype(\"int64\")\n",
    "clean_ds = make_ds(x_test, y_test)\n",
    "\n",
    "clean = []\n",
    "for name, path, m in models:\n",
    "    acc = accuracy_on_ds(m, clean_ds)\n",
    "    clean.append({\"name\": name, \"path\": str(path), \"clean_acc\": float(acc), \"clean_err\": err_from_acc(acc)})\n",
    "    print(f\"{name:16s} clean_acc={acc:.4f} clean_err={err_from_acc(acc):.4f}\")\n",
    "\n",
    "baseline = max(clean, key=lambda d: d[\"clean_err\"])  # Worst on clean split.\n",
    "BASELINE_NAME = baseline[\"name\"]\n",
    "print(\"\\nBaseline (worst on clean split):\", BASELINE_NAME, \"| clean_acc=%.4f\" % baseline[\"clean_acc\"])"
   ]
  },
