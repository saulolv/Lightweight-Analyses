      "Epoch 10: ReduceLROnPlateau reducing learning rate to 4.999999873689376e-06.\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m303s\u001b[0m 430ms/step - accuracy: 0.7608 - loss: 1.0978 - top5: 0.9838 - val_accuracy: 0.7924 - val_loss: 1.0373 - val_top5: 0.9898 - learning_rate: 1.0000e-05\n",
      "Epoch 11/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m299s\u001b[0m 425ms/step - accuracy: 0.7616 - loss: 1.0991 - top5: 0.9836 - val_accuracy: 0.7924 - val_loss: 1.0371 - val_top5: 0.9900 - learning_rate: 5.0000e-06\n",
      "Epoch 12/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m385s\u001b[0m 547ms/step - accuracy: 0.7609 - loss: 1.1001 - top5: 0.9834 - val_accuracy: 0.7926 - val_loss: 1.0371 - val_top5: 0.9900 - learning_rate: 5.0000e-06\n",
