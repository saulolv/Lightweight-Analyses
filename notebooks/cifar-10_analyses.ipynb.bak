     "name": "stderr",
     "output_type": "stream",
     "text": [
      "C:/home/anonymous/project/Lightweight Analyses/project/Lightweight Analyses\\project\\Lightweight Analyses\\.venv\\Lib\\site-packages\\keras\\src\\applications\\mobilenet_v3.py:454: UserWarning: `input_shape` is undefined or non-square, or `rows` is not 224. Weights for input shape (224, 224) will be loaded as the default.\n",
      "  return MobileNetV3(\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
