   "source": [
    "# Salva e avalia MCUNet com Transfer Learning\n",
    "mcunet_tl_keras_path, mcunet_tl_keras_model = save_best_as_keras(\n",
    "    build_mcunet_tl,\n",
    "    mcunet_tl_results,\n",
    "    filename=\"MCUNet_TL_CIFAR10.keras\",\n",
    ")\n",
    "mcunet_tl_eval, mcunet_tl_cm = evaluate_model(\n",
    "    mcunet_tl_keras_model, test_ds, class_names, title=\"MCUNet (Transfer Learning)\"\n",
    ")"
   ]
