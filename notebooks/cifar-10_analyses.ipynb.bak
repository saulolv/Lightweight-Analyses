   "id": "de9bb337",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "======================================================================\n",
      "COMPARISON: MCUNet (scratch) vs MCUNet (transfer learning)\n",
      "======================================================================\n",
      "Loading MCUNet (do zero) de: keras_models\\MCUNet_CIFAR10.keras\n",
