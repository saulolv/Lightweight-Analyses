    "    filename=\"MCUNet_Official_CIFAR10.keras\",\n",
    ")\n",
    "\n",
    "mcunet_off_eval, mcunet_off_cm = evaluate_model(\n",
    "    mcunet_off_keras_model, test_ds, class_names, title=\"MCUNet Oficial\"\n",
    ")"
