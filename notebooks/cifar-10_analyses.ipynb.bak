   "source": [
    "# Save the best model as .keras and evaluate (accuracy, F1, heatmaps)\n",
    "mnv3_keras_path, mnv3_keras_model = save_best_as_keras(\n",
    "    build_mobilenetv3_small,\n",
    "    mnv3_results,\n",
    "    filename=\"MobileNetV3Small_CIFAR10.keras\",\n",
    ")"
   ]
