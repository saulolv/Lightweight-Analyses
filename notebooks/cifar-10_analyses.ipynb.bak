   ],
   "source": [
    "import json\n",
    "import torch\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "# Configuração do MCUNet com transfer learning\n",
    "MCUNET_TL_CONFIG_PATH = Path(\"third_party/mcunet/assets/configs/mcunet-320kb-1mb_imagenet.json\")\n",
    "MCUNET_PT_WEIGHTS_PATH = Path(\"third_party/mcunet/assets/pt_ckpt/mcunet-320kb-1mb_imagenet.pth\")\n",
    "\n",
    "\n",
    "def _act_tl(x, act_name: str, name: str):\n",
    "    \"\"\"Função de ativação para MCUNet TL.\"\"\"\n",
    "    if act_name in (None, \"none\"):\n",
    "        return x\n",
    "    if act_name == \"relu6\":\n",
    "        return layers.ReLU(max_value=6.0, name=name)(x)\n",
    "    if act_name == \"relu\":\n",
    "        return layers.ReLU(name=name)(x)\n",
    "    raise ValueError(f\"Unsupported activation: {act_name}\")\n",
    "\n",
    "\n",
    "def build_mcunet_tl(\n",
    "    num_classes: int = NUM_CLASSES,\n",
    "    dropout: float = 0.2,\n",
    "    config_path: Path = MCUNET_TL_CONFIG_PATH,\n",
    "    weights_path: Path = MCUNET_PT_WEIGHTS_PATH,\n",
    "    load_pretrained: bool = True,\n",
    "):\n",
    "    \"\"\"\n",
    "    Constrói MCUNet com opção de carregar pesos pré-treinados do ImageNet.\n",
    "    \n",
    "    Retorna (model_completo, base_model) para compatibilidade com train_head_and_finetune.\n",
    "    - base_model: backbone (sem classifier) para fine-tuning\n",
    "    - model_completo: model final com nova cabeça CIFAR-10\n",
    "    \"\"\"\n",
    "    cfg = json.loads(config_path.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "    bn_cfg = cfg.get(\"bn\", {})\n",
    "    bn_momentum = 1.0 - float(bn_cfg.get(\"momentum\", 0.1))\n",
    "    bn_eps = float(bn_cfg.get(\"eps\", 1e-5))\n",
    "\n",
    "    # ========== BACKBONE (sem classifier) ==========\n",
    "    # MCUNet PyTorch usa normalização ImageNet: (x/255 - mean) / std\n",
    "    # mean = [0.485, 0.456, 0.406], std = [0.229, 0.224, 0.225]\n",
    "    # Criamos uma camada de normalização customizada\n",
    "    class ImageNetNormalization(layers.Layer):\n",
    "        def __init__(self, **kwargs):\n",
    "            super().__init__(**kwargs)\n",
    "            self.mean = tf.constant([0.485, 0.456, 0.406], dtype=tf.float32)\n",
    "            self.std = tf.constant([0.229, 0.224, 0.225], dtype=tf.float32)\n",
    "        \n",
    "        def call(self, x):\n",
    "            x = x / 255.0\n",
    "            return (x - self.mean) / self.std\n",
    "        \n",
    "        def get_config(self):\n",
    "            return super().get_config()\n",
    "    \n",
    "    preprocess = ImageNetNormalization(name=\"preprocess_mcunet_tl_imagenet\")\n",
    "    inputs, x = make_common_stem(preprocess)\n",
    "\n",
    "    # First conv\n",
    "    first = cfg[\"first_conv\"]\n",
    "    x = layers.Conv2D(\n",
    "        filters=int(first[\"out_channels\"]),\n",
    "        kernel_size=int(first[\"kernel_size\"]),\n",
    "        strides=int(first[\"stride\"]),\n",
    "        padding=\"same\",\n",
    "        use_bias=False,\n",
    "        name=\"mcunet_tl_first_conv\",\n",
    "    )(x)\n",
    "    x = layers.BatchNormalization(momentum=bn_momentum, epsilon=bn_eps, name=\"mcunet_tl_first_bn\")(x)\n",
    "    x = _act_tl(x, first.get(\"act_func\", \"relu6\"), name=\"mcunet_tl_first_act\")\n",
    "\n",
    "    # MBConv blocks\n",
    "    for i, block in enumerate(cfg.get(\"blocks\", [])):\n",
    "        mic = block.get(\"mobile_inverted_conv\")\n",
    "        if not mic or mic.get(\"name\") == \"ZeroLayer\":\n",
    "            continue\n",
    "\n",
    "        in_ch = int(mic[\"in_channels\"])\n",
    "        out_ch = int(mic[\"out_channels\"])\n",
    "        k = int(mic[\"kernel_size\"])\n",
    "        s = int(mic[\"stride\"])\n",
    "        expand_ratio = int(mic[\"expand_ratio\"])\n",
    "        mid_ch = mic.get(\"mid_channels\")\n",
    "        mid_ch = int(mid_ch) if mid_ch is not None else int(in_ch * expand_ratio)\n",
    "        act = mic.get(\"act_func\", \"relu6\")\n",
    "\n",
    "        shortcut = block.get(\"shortcut\") is not None and s == 1 and in_ch == out_ch\n",
    "        x_in = x\n",
    "\n",
    "        # expand (1x1)\n",
    "        if expand_ratio != 1:\n",
    "            x = layers.Conv2D(mid_ch, 1, padding=\"same\", use_bias=False, name=f\"mcunet_tl_b{i}_expand_conv\")(x)\n",
    "            x = layers.BatchNormalization(momentum=bn_momentum, epsilon=bn_eps, name=f\"mcunet_tl_b{i}_expand_bn\")(x)\n",
    "            x = _act_tl(x, act, name=f\"mcunet_tl_b{i}_expand_act\")\n",
    "\n",
    "        # depthwise\n",
    "        x = layers.DepthwiseConv2D(k, strides=s, padding=\"same\", use_bias=False, name=f\"mcunet_tl_b{i}_dwconv\")(x)\n",
    "        x = layers.BatchNormalization(momentum=bn_momentum, epsilon=bn_eps, name=f\"mcunet_tl_b{i}_dw_bn\")(x)\n",
    "        x = _act_tl(x, act, name=f\"mcunet_tl_b{i}_dw_act\")\n",
    "\n",
    "        # project (1x1)\n",
    "        x = layers.Conv2D(out_ch, 1, padding=\"same\", use_bias=False, name=f\"mcunet_tl_b{i}_project_conv\")(x)\n",
    "        x = layers.BatchNormalization(momentum=bn_momentum, epsilon=bn_eps, name=f\"mcunet_tl_b{i}_project_bn\")(x)\n",
    "\n",
    "        if shortcut:\n",
    "            x = layers.Add(name=f\"mcunet_tl_b{i}_add\")([x_in, x])\n",
    "\n",
    "    x = layers.GlobalAveragePooling2D(name=\"mcunet_tl_gap\")(x)\n",
    "    \n",
    "    # Backbone model (para fine-tuning)\n",
    "    base_model = tf.keras.Model(inputs, x, name=\"MCUNet_TL_Backbone\")\n",
    "\n",
    "    # ========== CABEÇA CIFAR-10 ==========\n",
    "    x = layers.Dropout(dropout, name=\"mcunet_tl_dropout\")(x)\n",
    "    outputs = layers.Dense(num_classes, activation=\"softmax\", name=\"mcunet_tl_classifier\")(x)\n",
    "\n",
    "    model = tf.keras.Model(inputs, outputs, name=\"MCUNet_TL_CIFAR10\")\n",
    "\n",
    "    # ========== CARREGAR PESOS PyTorch ==========\n",
    "    if load_pretrained and weights_path.exists():\n",
    "        print(f\"Loading pesos PyTorch de: {weights_path}\")\n",
    "        pt_ckpt = torch.load(weights_path, map_location=\"cpu\", weights_only=False)\n",
    "        # O checkpoint pode ter state_dict aninhado\n",
    "        pt_state = pt_ckpt.get(\"state_dict\", pt_ckpt)\n",
    "        \n",
    "        # Mapeia nomes PyTorch -> Keras\n",
    "        loaded_count = 0\n",
    "        skipped_layers = []\n",
    "        \n",
    "        for keras_layer in model.layers:\n",
    "            layer_name = keras_layer.name\n",
    "            weights_to_set = []\n",
    "            \n",
    "            # First conv\n",
    "            if layer_name == \"mcunet_tl_first_conv\":\n",
    "                pt_key = \"first_conv.conv.weight\"\n",
    "                if pt_key in pt_state:\n",
    "                    # PyTorch: (out, in, H, W) -> Keras: (H, W, in, out)\n",
    "                    w = pt_state[pt_key].numpy().transpose(2, 3, 1, 0)\n",
    "                    weights_to_set = [w]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            elif layer_name == \"mcunet_tl_first_bn\":\n",
    "                # Nota: no MCUNet original é \"first_conv.bn.weight\" (sem .bn extra)\n",
    "                gamma = pt_state.get(\"first_conv.bn.weight\")\n",
    "                beta = pt_state.get(\"first_conv.bn.bias\")\n",
    "                mean = pt_state.get(\"first_conv.bn.running_mean\")\n",
    "                var = pt_state.get(\"first_conv.bn.running_var\")\n",
    "                if gamma is not None:\n",
    "                    weights_to_set = [gamma.numpy(), beta.numpy(), mean.numpy(), var.numpy()]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            # MBConv blocks - expand conv\n",
    "            elif \"_expand_conv\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                pt_key = f\"blocks.{block_idx}.mobile_inverted_conv.inverted_bottleneck.conv.weight\"\n",
    "                if pt_key in pt_state:\n",
    "                    w = pt_state[pt_key].numpy().transpose(2, 3, 1, 0)\n",
    "                    weights_to_set = [w]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            elif \"_expand_bn\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                base_key = f\"blocks.{block_idx}.mobile_inverted_conv.inverted_bottleneck.bn\"\n",
    "                gamma = pt_state.get(f\"{base_key}.weight\")\n",
    "                beta = pt_state.get(f\"{base_key}.bias\")\n",
    "                mean = pt_state.get(f\"{base_key}.running_mean\")\n",
    "                var = pt_state.get(f\"{base_key}.running_var\")\n",
    "                if gamma is not None:\n",
    "                    weights_to_set = [gamma.numpy(), beta.numpy(), mean.numpy(), var.numpy()]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            # Depthwise conv\n",
    "            elif \"_dwconv\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                pt_key = f\"blocks.{block_idx}.mobile_inverted_conv.depth_conv.conv.weight\"\n",
    "                if pt_key in pt_state:\n",
    "                    # DepthwiseConv2D: PyTorch (out, 1, H, W) -> Keras (H, W, in, 1)\n",
    "                    w = pt_state[pt_key].numpy()\n",
    "                    w = w.transpose(2, 3, 0, 1)  # (H, W, out, 1) - para depthwise in==out\n",
    "                    weights_to_set = [w]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            elif \"_dw_bn\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                base_key = f\"blocks.{block_idx}.mobile_inverted_conv.depth_conv.bn\"\n",
    "                gamma = pt_state.get(f\"{base_key}.weight\")\n",
    "                beta = pt_state.get(f\"{base_key}.bias\")\n",
    "                mean = pt_state.get(f\"{base_key}.running_mean\")\n",
    "                var = pt_state.get(f\"{base_key}.running_var\")\n",
    "                if gamma is not None:\n",
    "                    weights_to_set = [gamma.numpy(), beta.numpy(), mean.numpy(), var.numpy()]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            # Project conv\n",
    "            elif \"_project_conv\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                pt_key = f\"blocks.{block_idx}.mobile_inverted_conv.point_linear.conv.weight\"\n",
    "                if pt_key in pt_state:\n",
    "                    w = pt_state[pt_key].numpy().transpose(2, 3, 1, 0)\n",
    "                    weights_to_set = [w]\n",
    "                    loaded_count += 1\n",
    "                    \n",
    "            elif \"_project_bn\" in layer_name:\n",
    "                block_idx = layer_name.split(\"_b\")[1].split(\"_\")[0]\n",
    "                base_key = f\"blocks.{block_idx}.mobile_inverted_conv.point_linear.bn\"\n",
    "                gamma = pt_state.get(f\"{base_key}.weight\")\n",
    "                beta = pt_state.get(f\"{base_key}.bias\")\n",
    "                mean = pt_state.get(f\"{base_key}.running_mean\")\n",
    "                var = pt_state.get(f\"{base_key}.running_var\")\n",
    "                if gamma is not None:\n",
    "                    weights_to_set = [gamma.numpy(), beta.numpy(), mean.numpy(), var.numpy()]\n",
    "                    loaded_count += 1\n",
    "\n",
    "            # Aplica os pesos\n",
    "            if weights_to_set:\n",
    "                try:\n",
    "                    keras_layer.set_weights(weights_to_set)\n",
    "                except Exception as e:\n",
    "                    skipped_layers.append((layer_name, str(e)))\n",
    "        \n",
    "        print(f\"✓ Weights loaded: {loaded_count} camadas\")\n",
    "        if skipped_layers:\n",
    "            print(f\"⚠ Camadas ignoradas: {len(skipped_layers)}\")\n",
    "            for name, err in skipped_layers[:5]:\n",
    "                print(f\"  - {name}: {err}\")\n",
    "    else:\n",
    "        print(\"⚠ Treinando do zero (sem pesos pré-treinados)\")\n",
    "\n",
    "    # Congela o backbone para treinar só a cabeça primeiro\n",
    "    for layer in base_model.layers:\n",
    "        layer.trainable = False\n",
    "\n",
    "    return model, base_model\n",
    "\n",
    "\n",
    "# Constrói e treina MCUNet com Transfer Learning\n",
    "print(\"=\" * 60)\n",
    "print(\"MCUNet com Transfer Learning (ImageNet -> CIFAR-10)\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "mcunet_tl_model, mcunet_tl_base = build_mcunet_tl()\n",
    "mcunet_tl_results, history_mcunet_tl_head, history_mcunet_tl_ft = train_head_and_finetune(\n",
    "    mcunet_tl_model,\n",
    "    mcunet_tl_base,\n",
    "    model_tag=\"MCUNet_TL\",  # distinct tag to avoid overwrites\n",
    ")"
   ]
  },
