    "# Save the best model as .keras and evaluate (accuracy, F1, heatmaps)\n",
    "effb0_keras_path, effb0_keras_model = save_best_as_keras(\n",
    "    build_efficientnetb0,\n",
    "    effnet_results,\n",
    "    filename=\"EfficientNetB0_CIFAR10.keras\",\n",
    ")"
   ]
