      "Epoch 5/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m251s\u001b[0m 356ms/step - accuracy: 0.7117 - loss: 1.1924 - top5: 0.9786 - val_accuracy: 0.7508 - val_loss: 1.1146 - val_top5: 0.9870 - learning_rate: 5.0000e-06\n",
      "Epoch 6/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m0s\u001b[0m 326ms/step - accuracy: 0.7162 - loss: 1.1877 - top5: 0.9788\n",
      "Epoch 6: ReduceLROnPlateau reducing learning rate to 2.499999936844688e-06.\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m254s\u001b[0m 360ms/step - accuracy: 0.7133 - loss: 1.1899 - top5: 0.9787 - val_accuracy: 0.7514 - val_loss: 1.1146 - val_top5: 0.9870 - learning_rate: 5.0000e-06\n",
      "Epoch 7/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m260s\u001b[0m 369ms/step - accuracy: 0.7113 - loss: 1.1911 - top5: 0.9789 - val_accuracy: 0.7512 - val_loss: 1.1145 - val_top5: 0.9870 - learning_rate: 2.5000e-06\n",
      "Epoch 8/20\n",
      "\u001b[1m704/704\u001b[0m \u001b[32m━━━━━━━━━━━━━━━━━━━━\u001b[0m\u001b[37m\u001b[0m \u001b[1m274s\u001b[0m 390ms/step - accuracy: 0.7126 - loss: 1.1895 - top5: 0.9787 - val_accuracy: 0.7514 - val_loss: 1.1145 - val_top5: 0.9870 - learning_rate: 2.5000e-06\n",
      "[MCUNet_TL] Test acc (best weights): 0.7576 | top5: 0.9847 | loss: 1.1143\n"
     ]
